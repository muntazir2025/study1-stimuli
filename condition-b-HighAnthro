const msgsEl=document.getElementById('msgs');
const tindEl=document.getElementById('tind');
const iboxEl=document.getElementById('ibox');
let mc=0;

function scrollDown(){msgsEl.scrollTop=msgsEl.scrollHeight;}
function timeStr(){const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}

function addMsg(role,text){
  const w=document.createElement('div');w.className='bw '+(role==='bot'?'bot':'usr');
  const lbl=document.createElement('div');lbl.className='blabel';
  if(role==='bot'){lbl.innerHTML='<div class="mini-av">'+miniAvSvg+'</div> Mark';}
  else{lbl.textContent='You';}
  w.appendChild(lbl);
  const b=document.createElement('div');b.className='bb '+(role==='bot'?'bot':'usr');
  b.textContent=text;w.appendChild(b);
  if(role==='usr'){
    const m=document.createElement('div');m.className='bm';const mid='bm'+(++mc);m.id=mid;m.textContent=timeStr();w.appendChild(m);
    setTimeout(()=>{const el=document.getElementById(mid);if(el)el.innerHTML=timeStr()+' <span class="tks">✓✓</span>';},400);
  }
  msgsEl.insertBefore(w,tindEl);scrollDown();
}

function readMs(text){const wc=text.trim().split(/\s+/).length;return Math.max(2200,Math.min(5000,wc*330));}

async function typeIn(text){
  iboxEl.value='';iboxEl.placeholder='';
  for(let i=0;i<text.length;i++){
    iboxEl.value=text.slice(0,i+1);
    let delay=72+(Math.random()*36-18);
    const ch=text[i];
    if(ch===' ')delay+=45+Math.random()*30;
    else if('.,:;!?\''.includes(ch))delay+=100+Math.random()*60;
    if(Math.random()<0.08)delay+=140+Math.random()*120;
    await sleep(delay);
  }
  await sleep(500);iboxEl.value='';iboxEl.placeholder='Type a message...';
}

async function showTyping(ms){tindEl.style.display='flex';scrollDown();await sleep(ms);tindEl.style.display='none';}

async function runChat(){
  await sleep(900);
  for(let i=0;i<CONV.length;i++){
    const{r,t}=CONV[i];const next=CONV[i+1];
    if(r==='bot'){await showTyping(1400);addMsg('bot',t);await sleep(readMs(t));}
    else{await typeIn(t);addMsg('usr',t);await sleep(next&&next.r==='bot'?700:550);}
  }
  await sleep(7000);
}

async function main(){
  await sleep(400);
  on('s1');await runBar('pb1',22000);off('s1');await sleep(680);
  on('s2');await runBar('pb2',16000);off('s2');await sleep(680);
  on('s3');await sleep(4000);off('s3');await sleep(680);
  on('s4');await runChat();
}
// Avatar loading logic
function applyAvatar(src){
  const ha=document.querySelector('.cr-avatar');
  if(ha)ha.innerHTML='<img class="mark-photo" src="'+src+'" alt="Mark">';
  const ta=document.querySelector('#tind .mini-av');
  if(ta)ta.innerHTML='<img class="mark-photo" src="'+src+'" alt="Mark">';
  miniAvSvg='<img class="mark-photo" src="'+src+'" alt="Mark">';
}

function hideLoader(){document.getElementById('img-loader').classList.add('hidden');}

// Try auto-loading mark-avatar.png (works on GitHub Pages)
const testImg=new Image();
testImg.onload=function(){
  applyAvatar('mark-avatar.png');
  hideLoader();
  main();
};
testImg.onerror=function(){
  // Show file picker for artifact preview
  document.getElementById('av-file').addEventListener('change',function(e){
    const file=e.target.files[0];
    if(!file)return;
    const reader=new FileReader();
    reader.onload=function(ev){
      applyAvatar(ev.target.result);
      hideLoader();
      main();
    };
    reader.readAsDataURL(file);
  });
};
testImg.src='mark-avatar.png';
