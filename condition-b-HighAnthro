<script>
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function resize(){const vp=document.getElementById('vp');const W=window.innerWidth,H=window.innerHeight;const R=16/9;let w=W,h=w/R;if(h>H){h=H;w=h*R;}vp.style.width=w+'px';vp.style.height=h+'px';document.documentElement.style.setProperty('--s',w/960);}
window.addEventListener('resize',resize);resize();
const on=id=>document.getElementById(id).classList.add('on');
const off=id=>document.getElementById(id).classList.remove('on');
async function runBar(id,ms){const el=document.getElementById(id);el.style.setProperty('--dur',ms+'ms');el.classList.add('run');await sleep(ms);}

let miniAvSvg='<img class="mark-photo" src="mark-avatar.png" alt="Mark">';

/* ═══ UPDATED Condition B Script ═══ */
const CONV=[
  {r:'bot',t:'Hi there \u{1F60A} I\'m Mark, your shopping assistant. How can I help you today?'},
  {r:'usr',t:"Hi. I'm planning to buy a laptop, and I found two options that both seem interesting: the Novara Flex 14 and the Novara Edge 15."},
  {r:'bot',t:'Hmm, I see.'},
  {r:'usr',t:"I'm confused about which one to choose, and I'd appreciate some help deciding."},
  {r:'bot',t:'Of course, I\'d be happy to help you think it through. Is the laptop for you, and what will you mainly use it for?'},
  {r:'usr',t:"It's for me, mainly for study and everyday work like writing, browsing, online meetings, and regular academic tasks."},
  {r:'bot',t:'Got it.'},
  {r:'usr',t:"I'm not looking for anything extreme, but I do want something dependable for daily use."},
  {r:'bot',t:'That makes sense. For that kind of use, battery life, value, portability, and long-term reliability are usually the big factors.'},
  {r:'bot',t:'Which of these matter most to you, and is there anything from your previous laptop you want to avoid?'},
  {r:'usr',t:"Battery life and value matter most to me. I use my laptop for long periods, so battery life affects my routine."},
  {r:'bot',t:'Right, I can see why that would matter.'},
  {r:'usr',t:"I do not want to pay extra unless it improves everyday use. My previous laptop became slow and the battery got worse over time. So I care more now about long-term reliability, not just specs on paper."},
  {r:'bot',t:'Oh, I see. That past experience would definitely make reliability feel more important. What is making the choice difficult now?'},
  {r:'usr',t:"The lower-priced option is tempting because of the 300 EUR difference, but I do not want to focus only on saving money. If I choose the cheaper option for the wrong reasons, then I have not really saved; I may have simply spent 750 EUR badly."},
