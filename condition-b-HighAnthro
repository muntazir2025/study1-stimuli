<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Novara Store — Condition B</title>
<style>
:root{--s:1}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%;overflow:hidden;background:#0a1020;display:flex;align-items:center;justify-content:center;font-family:'Segoe UI',system-ui,-apple-system,sans-serif}
#vp{position:relative;background:white;overflow:hidden;border-radius:4px;box-shadow:0 12px 60px rgba(0,0,0,.7)}
.scr{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;transition:opacity .65s ease;pointer-events:none}
.scr.on{opacity:1;pointer-events:all}

/* ═══ SCREEN 1 ═══ */
#s1{background:#f7f9fc}
.s1top{background:#1e3a5f;color:white;padding:calc(var(--s)*10px) calc(var(--s)*28px);display:flex;align-items:center;gap:calc(var(--s)*9px);font-size:calc(var(--s)*14px);font-weight:600;letter-spacing:.8px;flex-shrink:0}
.s1right{margin-left:auto;font-weight:400;font-size:calc(var(--s)*12px);opacity:.55}
.s1body{flex:1;padding:calc(var(--s)*24px) calc(var(--s)*64px);display:flex;flex-direction:column;justify-content:center;gap:calc(var(--s)*14px)}
.s1h{font-size:calc(var(--s)*22px);font-weight:700;color:#1e3a5f;padding-bottom:calc(var(--s)*12px);border-bottom:2px solid #dde6f0}
.s1p{font-size:calc(var(--s)*15.5px);color:#374151;line-height:1.82}
.s1p strong{color:#1e3a5f}

/* ═══ SCREEN 2 ═══ */
#s2{background:#eef2f7}
.snav{background:#1e3a5f;color:white;display:flex;align-items:center;gap:calc(var(--s)*22px);padding:calc(var(--s)*10px) calc(var(--s)*28px);font-size:calc(var(--s)*13px);flex-shrink:0}
.snav-brand{font-weight:700;font-size:calc(var(--s)*15px);letter-spacing:.8px}
.snav-lk{opacity:.55;cursor:default}
.snav-lk.act{opacity:1}
.s2sub{padding:calc(var(--s)*9px) calc(var(--s)*30px) 0;font-size:calc(var(--s)*13px);color:#5a6b7e;flex-shrink:0}
.s2deck{flex:1;display:flex;gap:calc(var(--s)*22px);padding:calc(var(--s)*8px) calc(var(--s)*30px) calc(var(--s)*14px)}
.pc{flex:1;background:white;border-radius:8px;border:1.5px solid #dce5ef;box-shadow:0 2px 12px rgba(30,58,95,.07);display:flex;flex-direction:column;overflow:hidden}
.pcimg{background:#f0f4f8;display:flex;justify-content:center;align-items:center;padding:calc(var(--s)*16px) calc(var(--s)*20px);border-bottom:1px solid #dce5ef;min-height:calc(var(--s)*100px)}
.pcbody{flex:1;padding:calc(var(--s)*12px) calc(var(--s)*18px);display:flex;flex-direction:column}
.pcbadge{display:inline-block;font-size:calc(var(--s)*11px);font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#2563eb;background:#eff6ff;padding:calc(var(--s)*2px) calc(var(--s)*7px);border-radius:3px;margin-bottom:calc(var(--s)*5px);width:fit-content}
.pcname{font-size:calc(var(--s)*19px);font-weight:700;color:#1e293b;margin-bottom:calc(var(--s)*8px)}
.pcsl{list-style:none;flex:1}
.pcsl li{display:flex;gap:calc(var(--s)*9px);padding:calc(var(--s)*4px) 0;border-bottom:1px solid #f1f5f9;font-size:calc(var(--s)*13px);color:#374151}
.sk{color:#94a3b8;font-size:calc(var(--s)*11.5px);width:calc(var(--s)*66px);flex-shrink:0;padding-top:1px}
.pcprice{background:#1e3a5f;color:white;padding:calc(var(--s)*10px) calc(var(--s)*18px);display:flex;align-items:baseline;gap:calc(var(--s)*5px)}
.pamt{font-size:calc(var(--s)*22px);font-weight:700}
.punit{font-size:calc(var(--s)*12px);opacity:.7}

/* ═══ SCREEN 3 ═══ */
#s3{background:#eef2f7;align-items:center;justify-content:center}
.s3box{background:white;border-radius:10px;border:2px solid #bfdbfe;box-shadow:0 4px 24px rgba(37,99,235,.1);padding:calc(var(--s)*34px) calc(var(--s)*60px);text-align:center}
.s3txt{font-size:calc(var(--s)*22px);font-weight:600;color:#1e3a5f;margin-top:calc(var(--s)*12px)}

/* ═══ SCREEN 4: Chat — HIGH ANTHROPOMORPHISM ═══ */
#s4{flex-direction:column;background:#f8fafc}
.crhd{background:#1e3a5f;color:white;padding:calc(var(--s)*10px) calc(var(--s)*24px);display:flex;align-items:center;gap:calc(var(--s)*12px);flex-shrink:0}
.cr-avatar{width:calc(var(--s)*38px);height:calc(var(--s)*38px);border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid rgba(255,255,255,.35);background:#e0e7ef}
.crtitl{font-size:calc(var(--s)*15px);font-weight:600}
.crsub{font-size:calc(var(--s)*11px);opacity:.55;margin-top:1px}
.cron{margin-left:auto;display:flex;align-items:center;gap:calc(var(--s)*5px);font-size:calc(var(--s)*11px);opacity:.8}
.odot{width:calc(var(--s)*7px);height:calc(var(--s)*7px);background:#4ade80;border-radius:50%}

#msgs{flex:1;overflow-y:auto;padding:calc(var(--s)*14px) calc(var(--s)*70px);display:flex;flex-direction:column;gap:calc(var(--s)*4px);background:#f8fafc}
#msgs::-webkit-scrollbar{width:4px}
#msgs::-webkit-scrollbar-thumb{background:#c0d4e8;border-radius:2px}

.bw{max-width:72%;display:flex;flex-direction:column;gap:2px;animation:pi .22s ease}
.bw.bot{align-self:flex-start}
.bw.usr{align-self:flex-end}
@keyframes pi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.blabel{font-size:calc(var(--s)*11.5px);font-weight:600;margin-bottom:1px;padding:0 calc(var(--s)*4px);display:flex;align-items:center;gap:calc(var(--s)*5px)}
.bw.usr .blabel{text-align:right;color:#3b82f6;justify-content:flex-end}
.bw.bot .blabel{color:#1e6b52}
.mini-av{width:calc(var(--s)*18px);height:calc(var(--s)*18px);border-radius:50%;overflow:hidden;flex-shrink:0}

.bb{padding:calc(var(--s)*9px) calc(var(--s)*15px);font-size:calc(var(--s)*14px);line-height:1.62;word-break:break-word}
.bb.bot{background:#e6f4ee;color:#1a2e26;border-radius:12px 12px 12px 3px}
.bb.usr{background:#2563eb;color:white;border-radius:12px 12px 3px 12px}

.bm{font-size:calc(var(--s)*10px);color:#94a3b8;display:flex;align-items:center;gap:3px;padding:0 calc(var(--s)*4px)}
.bw.usr .bm{justify-content:flex-end}
.tks{color:#60a5fa}

#tind{display:none;align-self:flex-start;flex-direction:column;gap:2px;animation:pi .22s ease}
#tind .blabel{font-size:calc(var(--s)*11.5px);font-weight:600;color:#1e6b52;padding:0 calc(var(--s)*4px);display:flex;align-items:center;gap:calc(var(--s)*5px)}
.dots-wrap{display:flex;padding:calc(var(--s)*10px) calc(var(--s)*16px);background:#e6f4ee;border-radius:12px 12px 12px 3px;gap:calc(var(--s)*5px);align-items:center;width:fit-content}
.dot{width:calc(var(--s)*6px);height:calc(var(--s)*6px);background:#3a8a68;border-radius:50%;animation:db 1.2s infinite}
.dot:nth-child(2){animation-delay:.22s}
.dot:nth-child(3){animation-delay:.44s}
@keyframes db{0%,65%,100%{transform:translateY(0);opacity:.3}32%{transform:translateY(-4px);opacity:1}}

.crinp{background:white;border-top:1px solid #dce5ef;padding:calc(var(--s)*9px) calc(var(--s)*24px);display:flex;align-items:center;gap:calc(var(--s)*9px);flex-shrink:0}
#ibox{flex:1;padding:calc(var(--s)*8px) calc(var(--s)*16px);border:1.5px solid #d0d9e8;border-radius:22px;font-size:calc(var(--s)*13.5px);font-family:inherit;color:#374151;background:#f8fafc;outline:none;pointer-events:none;height:calc(var(--s)*36px);min-height:22px}
.sbtn{width:calc(var(--s)*34px);height:calc(var(--s)*34px);background:#2563eb;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;min-width:22px;min-height:22px}

.pbar{position:absolute;bottom:0;left:0;height:3px;width:0%;background:#2563eb;z-index:100}
@keyframes pba{from{width:0%}to{width:100%}}
.pbar.run{animation:pba var(--dur) linear forwards}
.lsv{display:block;height:auto}
.mark-photo{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
#img-loader{position:absolute;inset:0;z-index:999;background:#0a1020;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:calc(var(--s)*14px);color:white;font-family:inherit}
#img-loader.hidden{display:none}
#img-loader h2{font-size:calc(var(--s)*18px);font-weight:600;color:#93c5fd}
#img-loader p{font-size:calc(var(--s)*13px);opacity:.7;max-width:400px;text-align:center;line-height:1.6}
#img-loader label{background:#2563eb;color:white;padding:calc(var(--s)*10px) calc(var(--s)*28px);border-radius:8px;font-size:calc(var(--s)*14px);font-weight:600;cursor:pointer;transition:background .2s}
#img-loader label:hover{background:#1d4ed8}
#img-loader input{display:none}
</style>
</head>
